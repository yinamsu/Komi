@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap');

:root {
    /* Color Palette */
    --color-primary: #0b3c2c;
    /* Deep Luxury Emerald */
    --color-primary-rgb: 11, 60, 44;
    --color-primary-light: #f2f7f4;
    --color-secondary: #0b1420;
    /* Deep Midnight */
    --color-secondary-rgb: 11, 20, 32;
    --color-accent: #c5a880;
    /* Champagne Gold / Soft Bronze */
    --color-accent-rgb: 197, 168, 128;
    --color-accent-light: #fbf9f6;

    --bg-primary: #faf9f6;
    /* Warm Off-White / Alabaster */
    --bg-primary-rgb: 250, 249, 246;
    --bg-secondary: #ffffff;
    --bg-dark: #0b1420;

    --text-primary: #1c2321;
    /* Soft Charcoal */
    --text-secondary: #5a6561;
    /* Muted Slate */
    --text-light: #ffffff;
    --text-muted: #8e9a96;

    --color-danger: #a94442;
    --color-danger-light: #fbf2f2;
    --color-success: #2e7d32;
    --color-success-light: #e8f5e9;

    /* Borders & Shadows */
    --border-color: #e5eae6;
    --border-glow: rgba(197, 168, 128, 0.3);

    --shadow-soft: 0 4px 20px rgba(11, 20, 32, 0.04);
    --shadow-medium: 0 12px 30px rgba(11, 20, 32, 0.08);
    --shadow-glow: 0 0 25px rgba(197, 168, 128, 0.15);

    --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-serif: 'Playfair Display', Georgia, serif;

    --transition-smooth: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    --transition-bounce: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);

    /* Backgrounds distinct override */
    --color-footer-bg: #0b1420;
    --color-btn-bg: #0b1420;
    --color-btn-text: #ffffff;
    --color-badge-bg: #0b1420;
    --color-badge-text: #ffffff;
}

/* EXPLICIT THEME OVERRIDES (Enforced via JS) */
html[data-theme="light"] {
    --color-primary: #0b3c2c;
    --color-primary-rgb: 11, 60, 44;
    --color-primary-light: #f2f7f4;
    --color-secondary: #0b1420;
    --color-secondary-rgb: 11, 20, 32;
    --color-accent: #c5a880;
    --color-accent-rgb: 197, 168, 128;
    --color-accent-light: #fbf9f6;

    --bg-primary: #faf9f6;
    --bg-primary-rgb: 250, 249, 246;
    --bg-secondary: #ffffff;
    --bg-dark: #0b1420;

    --text-primary: #1c2321;
    --text-secondary: #5a6561;
    --text-light: #ffffff;
    --text-muted: #8e9a96;

    --border-color: #e5eae6;
    --border-glow: rgba(197, 168, 128, 0.3);

    --shadow-soft: 0 4px 20px rgba(11, 20, 32, 0.04);
    --shadow-medium: 0 12px 30px rgba(11, 20, 32, 0.08);

    --color-footer-bg: #0b1420;
    --color-btn-bg: #0b1420;
    --color-btn-text: #ffffff;
    --color-badge-bg: #0b1420;
    --color-badge-text: #ffffff;
}

html[data-theme="dark"] {
    --color-primary: #165b45;
    --color-primary-rgb: 22, 91, 69;
    --color-primary-light: #12221b;
    --color-secondary: #f3f4f6;
    --color-secondary-rgb: 243, 244, 246;
    --color-accent: #dcbfa0;
    --color-accent-rgb: 220, 191, 160;
    --color-accent-light: #161513;

    --bg-primary: #0a0f18;
    --bg-primary-rgb: 10, 15, 24;
    --bg-secondary: #111827;
    --bg-dark: #070a10;

    --text-primary: #f3f4f6;
    --text-secondary: #9ca3af;
    --text-light: #ffffff;
    --text-muted: #6b7280;

    --border-color: #1f2937;
    --border-glow: rgba(220, 191, 160, 0.1);
    --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.2);
    --shadow-medium: 0 12px 30px rgba(0, 0, 0, 0.4);

    --color-footer-bg: #070a10;
    --color-btn-bg: #165b45;
    --color-btn-text: #ffffff;
    --color-badge-bg: #12221b;
