}

.reader-page.active {
    display: block;
}

.reader-page h4 {
    font-size: 22px;
    color: var(--color-secondary);
    margin-bottom: 16px;
    font-family: var(--font-serif);
}

.reader-page p {
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 16px;
    color: var(--text-secondary);
}

.reader-page strong {
    color: var(--color-secondary);
}

.reader-page blockquote {
    background-color: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    padding: 16px 20px;
    margin: 20px 0;
    border-radius: 0 8px 8px 0;
    font-size: 13px;
    line-height: 1.5;
}

.reader-page blockquote strong {
    display: block;
    margin-bottom: 6px;
    color: var(--color-primary);
}

/* Interactive Checklist inside Ebook */
.safety-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0;
}

.checklist-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 12px 16px;
    background-color: var(--bg-primary);
    border-radius: 8px;
    border: 1px solid var(--border-color);
}

.checklist-checkbox {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid var(--color-accent);
    cursor: pointer;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
}

.checklist-checkbox.checked {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
}

.checklist-checkbox.checked::after {
    content: '✓';
    color: #fff;
    font-size: 12px;
    font-weight: bold;
}

.checklist-details h5 {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 4px;
}

.checklist-details p {
    font-size: 12px;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.4;
}

.modal-footer {
    border-top: 1px solid var(--border-color);
    padding: 18px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.reader-nav-btn {
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
    color: var(--color-secondary);
}

.reader-nav-btn:hover:not(:disabled) {
    background-color: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary);
}

.reader-nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.reader-coupon {
    display: flex;
    align-items: center;
    gap: 8px;
