html[data-theme="dark"] .lang-btn.active {
    background: var(--color-accent);
    color: #0a0f18;
    box-shadow: 0 2px 10px rgba(var(--color-accent-rgb), 0.3);
}

html[data-theme="dark"] .theme-btn.active {
    background: rgba(var(--color-accent-rgb), 0.15);
}

/* Header responsive — hide badge on small screens, stack switchers */
@media (max-width: 768px) {
    .badge-verified {
        display: none;
    }

    .lang-btn {
        padding: 5px 10px;
        font-size: 12px;
    }

    .theme-btn {
        width: 28px;
        height: 28px;
        font-size: 12px;
    }
}

/* Hero Section */
.hero {
    padding: 80px 0 60px;
    position: relative;
}

.hero-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(197, 168, 128, 0.15) 0%, rgba(250, 249, 246, 0) 70%);
