    flex-shrink: 0;
}

.safety-check-icon.active {
    color: var(--color-success);
}

.safety-check-icon.inactive {
    color: var(--text-muted);
}

/* 4. Doctor's Perspective Section */
.section-doctor-view {
    padding: 100px 0;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
}

.dr-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-top: 40px;
}

@media(min-width: 768px) {
    .dr-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

.dr-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 40px 30px;
    box-shadow: var(--shadow-soft);
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.dr-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-medium);
    border-color: var(--color-accent);
}

.dr-card-icon {
    font-size: 32px;
}

.dr-card h4 {
    font-size: 18px;
    color: var(--color-secondary);
}

.dr-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
}

/* 5. Legacy Comparison Matrix Table */
.section-diff {
    padding: 100px 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
}

.table-responsive {
    width: 100%;
    overflow-x: auto;
    margin-top: 45px;
    box-shadow: var(--shadow-medium);
    border-radius: 16px;
    border: 1px solid var(--border-color);
}

.diff-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
    background-color: var(--bg-secondary);
    text-align: left;
}

.diff-table th,
.diff-table td {
    padding: 20px 24px;
    font-size: 14px;
    border-bottom: 1px solid var(--border-color);
}

.diff-table th {
    background-color: var(--bg-primary);
    font-weight: 700;
    color: var(--color-secondary);
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.05em;
}

.diff-table tr:last-child td {
    border-bottom: none;
}

.diff-table td:first-child {
    font-weight: 600;
    color: var(--color-secondary);
    width: 25%;
}

.diff-table td.legacy-col {
    color: var(--text-muted);
    width: 37.5%;
}

.diff-table td.komi-col {
    color: var(--text-primary);
    font-weight: 500;
    background-color: rgba(197, 168, 128, 0.02);
    border-left: 1px solid rgba(197, 168, 128, 0.1);
    border-right: 1px solid rgba(197, 168, 128, 0.1);
    width: 37.5%;
}

.diff-table tr:hover td {
    background-color: var(--bg-primary);
}

.diff-table tr:hover td.komi-col {
    background-color: rgba(197, 168, 128, 0.05);
}

.diff-highlight-text {
    color: var(--color-primary);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

html[data-theme="dark"] .diff-highlight-text {
    color: var(--color-accent);
}

/* 6. Review Writer Simulator Modal & Form elements */
.btn-review-trigger {
    margin: 40px auto 0;
    display: flex;
}

/* Steps Progress bar */
.writer-steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    position: relative;
    padding: 0 10px;
}

.writer-steps::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--border-color);
    z-index: 1;
    transform: translateY(-50%);
}

.step-indicator {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--bg-secondary);
    border: 2px solid var(--border-color);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    z-index: 2;
    transition: var(--transition-smooth);
}

.step-indicator.active {
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    box-shadow: 0 0 10px rgba(197, 168, 128, 0.2);
}

.step-indicator.completed {
    border-color: var(--color-success);
    background-color: var(--color-success);
    color: #fff;
}

.writer-panels {
    position: relative;
    min-height: 380px;
}

.writer-panel {
    display: none;
    animation: fadeInSlide 0.4s ease forwards;
}

.writer-panel.active {
    display: block;
}

/* Document upload simulation dropzone */
.dropzone-simulator {
    border: 2px dashed var(--border-color);
    background-color: var(--bg-primary);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    cursor: pointer;
    transition: var(--transition-smooth);
    position: relative;
    overflow: hidden;
    margin-bottom: 20px;
}

.dropzone-simulator:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
}

.dropzone-icon {
    font-size: 32px;
    margin-bottom: 8px;
    color: var(--text-muted);
}

.dropzone-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-secondary);
    margin-bottom: 4px;
    display: block;
}

.dropzone-help {
    font-size: 12px;
    color: var(--text-muted);
}

.upload-success-indicator {
    display: none;
    color: var(--color-success);
    font-weight: 700;
    font-size: 13px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 8px;
}

/* Rating Sliders styling */
.review-rating-row {
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
}

.review-rating-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.rating-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.rating-title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-secondary);
}

.rating-value-badge {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-accent);
    background-color: var(--color-accent-light);
    padding: 2px 8px;
    border-radius: 6px;
}

.rating-slider {
    width: 100%;
    height: 6px;
    background: var(--border-color);
    border-radius: 5px;
    outline: none;
    accent-color: var(--color-accent);
    cursor: pointer;
    transition: var(--transition-smooth);
}

.rating-select-group {
    display: flex;
    gap: 10px;
    margin-top: 6px;
}

.rating-select-btn {
    flex: 1;
    padding: 10px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-smooth);
    text-align: center;
}

.rating-select-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-secondary);
}

.rating-select-btn.active {
    background-color: var(--color-accent-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
}

/* Whistleblower card inside review writer */
.whistleblower-box {
    background-color: rgba(169, 68, 66, 0.04);
    border: 1px solid rgba(169, 68, 66, 0.15);
    border-radius: 12px;
    padding: 20px;
    margin-top: 24px;
    position: relative;
}

.whistleblower-box-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-danger);
    margin-bottom: 6px;
}

.whistleblower-box p {
    font-size: 12.5px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 12px;
}

.whistleblower-report-btn {
    width: 100%;
    padding: 12px;
    background-color: var(--color-danger);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-transform: uppercase;
    letter-spacing: 0.02em;
}

.whistleblower-report-btn:hover {
    background-color: #8c2a29;
}

.whistleblower-success-msg {
    display: none;
    background-color: var(--color-success-light);
    border: 1px solid rgba(46, 125, 50, 0.2);
    color: var(--color-success);
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 500;
    text-align: center;
}

/* Modal Control Actions block */
.writer-controls {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border-color);
    padding-top: 20px;
    margin-top: 24px;
    gap: 12px;
}

.btn-writer-nav {
    padding: 12px 24px;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition-smooth);
}

.btn-writer-nav.prev {
    background: none;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
}

.btn-writer-nav.prev:hover {
    background-color: var(--bg-primary);
    color: var(--color-secondary);
}

.btn-writer-nav.next {
    background-color: var(--color-primary);
    border: none;
    color: #fff;
}

.btn-writer-nav.next:hover {
    background-color: var(--color-secondary);
}

/* Success panel animation styles */
.success-checkmark-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 30px 10px;
}

.success-icon-badge {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--color-success-light);
    color: var(--color-success);
    font-size: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

.success-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-secondary);
}

.success-text {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.5;
}

/* ========================================================
   [최종 패치] 한글 세리프/이탤릭 완전 제거 및 투명화 오타 복구
   ======================================================== */

/* 1. 타이틀 서리프 태그 강제 오버라이드 및 색상 복구 */
.section-title-serif {
    font-family: var(--font-sans) !important;
    /* 궁서체 계열 배제, 세련된 고딕 통일 */
    font-style: normal !important;
    /* 어색하게 눕는 이탤릭 해제 */
    font-weight: 800 !important;
    /* 볼드하고 묵직한 두께감 통일 */

    /* 투명화 버그 복구: 올바른 헥사코드(#) 포맷팅 적용 */
    background: linear-gradient(135deg, var(--color-accent) 0%, #ffffff 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    display: inline !important;
    /* 줄바꿈 꼬임 방지 및 텍스트 강제 노출 */
}

/* 2. 모달 내 기타 명조체 유발 태그 서체 일괄 안정화 */
.reader-page h4,
.reader-page font,
.reader-page blockquote {
    font-family: var(--font-sans) !important;
    font-style: normal !important;
}

/* ========================================================
   [마감 패치] 리뷰 시뮬레이터 내부 경계선 겹침 버그 진압
   ======================================================== */

/* 리뷰 모달 내부에서는 사이드바용 배경과 보더 경계선을 원천 차단 */
#reviewWriterModal .modal-body {
    display: block !important;
    /* 2열 분할 강제 해제 */
    background: transparent !important;
    border-right: none !important;
}

/* 시뮬레이터 내부의 겹침 레이아웃 완전 청소 */
#reviewWriterModal .writer-panel {
    border-left: none !important;
    padding-left: 0 !important;
}

/* 드롭다운 및 업로드 박스 간의 간격(마진) 안정화 */
#reviewWriterModal .form-group {
    margin-bottom: 24px !important;
}

#reviewWriterModal .dropzone-simulator {
    margin-top: 8px !important;
    margin-bottom: 24px !important;
}

/* ========================================================
   [최종 마감] 리뷰 시뮬레이터 하단 버튼 짤림 방지 (스크롤 가드)
   ======================================================== */

/* 1. 리뷰 모달의 콘텐츠 영역 전체에 스크롤 기능 주입 */
#reviewWriterModal .modal-body {
    max-height: calc(80vh - 160px) !important;
    /* 모달 전체 높이에서 헤더/푸터 제외 */
    overflow-y: auto !important;
    /* 내용이 넘치면 내부에만 스크롤바 생성 */
    padding-bottom: 20px !important;
}

/* 2. 스크롤바 스타일을 딥테마에 맞게 미니멀하게 튜닝 */
#reviewWriterModal .modal-body::-webkit-scrollbar {
    width: 6px;
}

#reviewWriterModal .modal-body::-webkit-scrollbar-track {
    background: transparent;
}

#reviewWriterModal .modal-body::-webkit-scrollbar-thumb {
    background-color: var(--border-color);
    border-radius: 10px;
}

#reviewWriterModal .modal-body::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-accent);
}

/* 3. 하단 컨트롤 버튼 영역이 무조건 하단에 고정되도록 마감 */
#reviewWriterModal .writer-controls {
    margin-top: 0 !important;
    padding-top: 16px !important;
    border-top: 1px solid var(--border-color) !important;
    background-color: var(--bg-secondary) !important;
    /* 뒤쪽 콘텐츠가 비치지 않게 배경 고정 */
}

/* ========================================================
   [치료 카테고리 & 하위메뉴 스타일링] - 프리미엄 K-뷰티 테마
   ======================================================== */

.category-selector-widget {
    margin-top: 24px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* 메인 카테고리 탭 (가로 스크롤 가능형) */
.category-tabs-wrapper {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
}

.category-tabs-wrapper::-webkit-scrollbar {
    height: 4px;
}

.category-tabs-wrapper::-webkit-scrollbar-track {
    background: transparent;
}

.category-tabs-wrapper::-webkit-scrollbar-thumb {
    background-color: var(--border-color);
    border-radius: 4px;
}

.category-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--border-color);
    border-radius: 30px;
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-smooth);
}

.category-tab:hover {
    border-color: var(--color-accent);
    color: var(--text-primary);
    transform: translateY(-2px);
}

.category-tab.active {
    background-color: var(--color-primary);
    color: var(--text-light);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-glow);
}

/* 하부메뉴 펼침 패널 */
.category-submenu-panel {
    background-color: var(--color-primary-light);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 24px;
    box-shadow: var(--shadow-soft);
    min-height: 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

/* 서브메뉴 콘텐츠 기본 상태 */
.submenu-content {
    display: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
}

/* 서브메뉴 콘텐츠 활성 상태 */
.submenu-content.active {
    display: flex;
    flex-direction: column;
    gap: 20px;
    opacity: 1;
    transform: translateY(0);
}

/* 서브메뉴 정보/안내 텍스트 */
.submenu-info {
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
}

/* 개별 서브카테고리 그룹 (데스크탑에서 좌우 정렬, 모바일에서 상하 분리) */
.submenu-group {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: 16px;
}

.submenu-group:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

/* 서브카테고리 제목 */
.submenu-title {
    flex: 0 0 160px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary);
    padding-top: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* 다크모드 대응 */
html[data-theme="dark"] .submenu-title {
    color: var(--color-accent);
}

/* 개별 시술 칩 리스트 */
.submenu-items {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

/* 개별 시술 태그 칩 */
.treat-chip {
    padding: 6px 14px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
}

.treat-chip:hover {
    border-color: var(--color-accent);
    color: var(--text-primary);
    transform: scale(1.03);
}

.treat-chip.active {
    background-color: var(--color-accent);
    color: var(--color-primary);
    border-color: var(--color-accent);
    font-weight: 700;
    box-shadow: 0 2px 10px rgba(197, 168, 128, 0.2);
}

/* 모바일 반응형 대응 */
@media (max-width: 768px) {
    .submenu-group {
        flex-direction: column;
        gap: 8px;
    }
    
    .submenu-title {
        flex: auto;
        padding-top: 0;
        margin-bottom: 4px;
        font-size: 12px;
    }
}

/* ========================================================
   [비주얼 카테고리 메뉴 (9개 아이콘) 스타일]
   ======================================================== */
.visual-category-container {
    margin-bottom: 35px;
    width: 100%;
}

.visual-category-title {
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 20px;
    letter-spacing: 0.5px;
}

.visual-category-menu {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px 24px;
}

.visual-category-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.2s ease;
    width: 75px;
}

.visual-category-item:hover {
    transform: translateY(-4px);
}

.icon-circle {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    border: 2px solid transparent;
}

.visual-category-item:hover .icon-circle {
    box-shadow: 0 6px 15px rgba(255, 255, 255, 0.05);
}

.visual-category-item.active .icon-circle {
    border-color: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
    transform: scale(1.05);
}

.icon-circle svg {
    width: 26px;
    height: 26px;
}

.visual-category-item .label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-secondary);
    transition: color 0.2s ease;
    text-align: center;
    white-space: nowrap;
}

.visual-category-item:hover .label,
.visual-category-item.active .label {
    color: var(--text-primary);
}

/* 아이콘 개별 테마 색상 (그라데이션 매칭) */
.bg-epilation {
    background: linear-gradient(135deg, #10b981, #059669); /* 녹색 */
}
.bg-lifting {
    background: linear-gradient(135deg, #ff6b8b, #ec4899); /* 핑크 */
}
